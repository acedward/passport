// ── Challenge constructions, arm evm ────────────────────────────────────────
//
// Preimage:
//   [DST_CIRCUIT, self, address, ...args, ...witness_values, auth_nonce]
// The k256 arm's preimage with the key encoded as the device's 20-byte Ethereum
// address instead of its two affine coordinates — the identity this arm enrols.
// Everything else is identical: no signature term, no grinding nonce, the same
// witness-value pinning (AUTH-10), the same one-DST-per-circuit rule (AUTH-3).
//
// The challenge is NOT what the wallet signs on this arm: it is one field of the
// EIP-712 struct whose digest the wallet signs (docs/AUTH-EIP712-PASSPORT-EVM-V1.md).
// That is what lets the wallet display readable action fields while the circuit
// still binds the private witness values the wallet cannot see — the readable
// fields and the challenge cover the same arguments, so a signature that looks
// right in MetaMask and means something else in the circuit does not exist.

export pure circuit challenge_withdraw_unshielded_with_evm(
  self_addr:   ContractAddress,
  address:     Bytes<20>,
  color:       Bytes<32>,
  amount:      Uint<128>,
  recipient:   UserAddress,
  nonce_value: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:evm:v1:withdraw_unshielded")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, Bytes<20>, Bytes<32>, Uint<128>, UserAddress, Uint<64>]>(
    [dst, self_addr, address, color, amount, recipient, nonce_value]
  );
}

export pure circuit challenge_withdraw_shielded_with_evm(
  self_addr:   ContractAddress,
