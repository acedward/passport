    [dst, self_addr, sig_r, pk, entry, nonce_value, grind_nonce]
  );
}

// The open-offer challenge. It binds MORE than any other circuit's because an offer is the one
// authorisation that travels: the maker proves it, publishes it, and a stranger settles it minutes
// later. Everything the settled transaction will contain is therefore in the preimage — both legs,
// the recipient shape, the deadline, BOTH inbox entries in full, and the witness coin (AUTH-10) —
// so "the offer that was approved" and "the offer that executed" cannot differ in any field.
export pure circuit challenge_open_swap_shielded_with_jubjub(
  self_addr:      ContractAddress,
  sig_r:          JubjubPoint,
  pk:             JubjubPoint,
  give_color:     Bytes<32>,
  give_amount:    Uint<128>,
  recipient_kind: Uint<8>,
  recipient:      Bytes<32>,
  want:           ShieldedCoinInfo,
  want_entry:     Bytes<192>,
  change_entry:   Bytes<192>,
  valid_until:    Uint<64>,
  coin:           QualifiedShieldedCoinInfo,
  nonce_value:    Uint<64>,
  grind_nonce:    Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:v1:open_swap_shielded")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, JubjubPoint, JubjubPoint, Bytes<32>, Uint<128>, Uint<8>, Bytes<32>, ShieldedCoinInfo, Bytes<192>, Bytes<192>, Uint<64>, QualifiedShieldedCoinInfo, Uint<64>, Uint<64>]>(
    [dst, self_addr, sig_r, pk, give_color, give_amount, recipient_kind, recipient, want,
     want_entry, change_entry, valid_until, coin, nonce_value, grind_nonce]
  );
}

// ── Challenge constructions, arm k256 ───────────────────────────────────────
//
// Preimage:
//   [DST_CIRCUIT, self, pk_x, pk_y, ...args, ...witness_values, auth_nonce]
// Same binding discipline as the jubjub arm (AUTH-10, §5.3), with two
// scheme-driven differences: no signature term (an ECDSA message must not
// depend on its own signature) and no grinding nonce (secp256k1EcdsaVerify
// reduces the 32-byte challenge mod n natively).

export pure circuit challenge_withdraw_unshielded_with_k256(
  self_addr:   ContractAddress,
  pk:          Secp256k1Point,
  color:       Bytes<32>,
  amount:      Uint<128>,
  recipient:   UserAddress,
  nonce_value: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:k1:v1:withdraw_unshielded")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, Bytes<32>, Bytes<32>, Bytes<32>, Uint<128>, UserAddress, Uint<64>]>(
    [dst, self_addr,
     secp256k1PointX(pk) as Bytes<32>, secp256k1PointY(pk) as Bytes<32>,
     color, amount, recipient, nonce_value]
  );
}

