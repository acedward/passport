// The `evm` twin of the open-offer challenge. Same preimage, the key encoded as the 20-byte
// Ethereum address. Note what is here and NOT in the EIP-712 struct above it: the two 192-byte inbox
// entries and the witness coin. They are the fields a wallet cannot render — ciphertext and a
// private coin description — and the challenge is where they are pinned, which is the whole reason
// this arm signs a struct that CONTAINS a challenge rather than a struct alone.
export pure circuit challenge_open_swap_shielded_with_evm(
  self_addr:      ContractAddress,
  address:        Bytes<20>,
  give_color:     Bytes<32>,
  give_amount:    Uint<128>,
  recipient_kind: Uint<8>,
  recipient:      Bytes<32>,
  want:           ShieldedCoinInfo,
  want_entry:     Bytes<192>,
  change_entry:   Bytes<192>,
  valid_until:    Uint<64>,
  coin:           QualifiedShieldedCoinInfo,
  nonce_value:    Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:evm:v1:open_swap_shielded")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, Bytes<20>, Bytes<32>, Uint<128>, Uint<8>, Bytes<32>, ShieldedCoinInfo, Bytes<192>, Bytes<192>, Uint<64>, QualifiedShieldedCoinInfo, Uint<64>]>(
    [dst, self_addr, address, give_color, give_amount, recipient_kind, recipient, want,
     want_entry, change_entry, valid_until, coin, nonce_value]
  );
}

// ── Challenge constructions, arm evm: the ERC20 bridge (PR-G) ───────────────
//
// Same preimage rule as every other `evm` challenge — [DST_CIRCUIT, self, address, ...args,
// ...witness_values, auth_nonce] — for the two device-gated bridge starts.
//
// Both bind EVERY parameter of the Ethereum transaction the MPC will sign (`evm_nonce`,
// `gas_limit`, `max_fee`, `max_priority_fee`, `key_version`). That is the reason these two
// circuits are gated at all, and it is not about the bridged value: the signed transaction
// spends GAS from an account the MPC derives, and a relayer free to choose the gas fields
// could drain that account by having the MPC sign a maximally expensive transaction. The
// value itself is already safe — the recipient is pinned to `kernel.self()` inside the
// circuit and cannot be influenced from outside.

export pure circuit challenge_bridge_deposit_start_with_evm(
  self_addr:        ContractAddress,
  address:          Bytes<20>,
  erc20:            Bytes<20>,
  amount:           Uint<128>,
  evm_nonce:        Uint<64>,
  gas_limit:        Uint<64>,
  max_fee:          Uint<128>,
  max_priority_fee: Uint<128>,
  key_version:      Uint<8>,
  nonce_value:      Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:evm:v1:bridge_deposit_start")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, Bytes<20>, Bytes<20>, Uint<128>,
                         Uint<64>, Uint<64>, Uint<128>, Uint<128>, Uint<8>, Uint<64>]>(
    [dst, self_addr, address, erc20, amount,
     evm_nonce, gas_limit, max_fee, max_priority_fee, key_version, nonce_value]
  );
}

// The withdraw start binds two things the EIP-712 struct cannot show and therefore does not
// carry: the ERC20 address (the colour already identifies the asset in the wallet prompt,
// and this is the second binding), and the qualified coin the `held_coin` witness returned
// (AUTH-10 — the approver signs over the exact coin the spend will consume, which the
// wallet cannot see).
//
// The `change_entry` ARGUMENT of the circuit is deliberately NOT bound here, and this is
// the one place in the whole arm where an argument escapes the challenge. The reason is
// measured, not stylistic (question Q41): the nonce the standard library gives the change
// coin of a `sendShielded` is NOT an `evolveNonce` of the spent coin's nonce on this
// runtime — no index from 0 to 15, at one or two levels, reproduces it — so a client cannot
// seal the change entry before the call. It CAN learn the nonce by executing the call
// locally first (the execution is deterministic for the same state and arguments, also
// measured), but only if it already holds a signature to execute WITH. Binding the entry
// would therefore cost a second wallet prompt for every withdrawal that leaves change.
//
// What an unbound entry can and cannot do: it is ciphertext the contract never inspects, so
// a wrong one strands DISCOVERY of the change coin and nothing else — the coin is created
// either way, it stays in the client's own store, and it is spendable. `deposit_shielded`
// has accepted an arbitrary entry from an arbitrary caller since MIP-0012 §6.2 for the same
// reason. The change can always be re-filed later with `append_inbox_with_evm` (INV-4).
export pure circuit challenge_bridge_withdraw_start_with_evm(
  self_addr:        ContractAddress,
  address:          Bytes<20>,
  dest:             Bytes<20>,
  color:            Bytes<32>,
  amount:           Uint<128>,
  evm_nonce:        Uint<64>,
  gas_limit:        Uint<64>,
  max_fee:          Uint<128>,
  max_priority_fee: Uint<128>,
  key_version:      Uint<8>,
  erc20:            Bytes<20>,
  coin:             QualifiedShieldedCoinInfo,
  nonce_value:      Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:evm:v1:bridge_withdraw_start")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, Bytes<20>, Bytes<20>, Bytes<32>, Uint<128>,
                         Uint<64>, Uint<64>, Uint<128>, Uint<128>, Uint<8>, Bytes<20>,
                         QualifiedShieldedCoinInfo, Uint<64>]>(
    [dst, self_addr, address, dest, color, amount,
     evm_nonce, gas_limit, max_fee, max_priority_fee, key_version, erc20,
     coin, nonce_value]
  );
}

// ── The authorisation seam (MIP-0012 §4), one chip per arm ──────────────────
//
// One seam chip per arm gates every asset-releasing and state-changing
// circuit other than deposits (INV-1). Adding a credential scheme adds a
// seam chip and a challenge family; the custody chips below are untouched.
// Order per MIP-0013 §4: consume the device entry (and insert its
// successor), challenge (computed by the caller), verification, freshness.
//
// The entry consumed and the successor inserted are disclosed by the ledger
// operations themselves; both are single-use values (AUTH-9; MIP-0013 S4
// bounds the residual transcript chaining). The signature material is
// witness data of the proof and appears in no public output. An
// unregistered key, a key of the other arm, a stale epoch, and a wrong use
// counter all fail the membership assert identically.

circuit require_authorised_with_jubjub(
  pk:          JubjubPoint,
  use_counter: Uint<64>,
  sig_r:       JubjubPoint,
  sig_s:       Field,
  challenge:   Bytes<32>,
): [] {
  // The same weak-key break the k256 arm has, on the normative arm. The seam
  // asserts s·G == R + c·pk, so a pk of small order lets the key-dependent
  // term be predicted or erased: at the identity it vanishes outright and any
  // s with R = s·G passes with no private key. JubJub's identity is the
  // ordinary affine point (0, 1), not a flagged encoding, so nothing about the
  // type rules it out. Cofactor-clearing rejects it and the rest of the
  // 8-torsion in one check: [8]P == O exactly when P has small order.
  assert(ecMul(pk, 8 as JubjubScalar) != ecMulGenerator(0 as JubjubScalar),
         "device key has small order");
  const entry = disclose(derive_device_entry_with_jubjub(kernel.self(), pk, device_epoch, use_counter));
  assert(devices.member(entry), "unknown device entry");
  devices.remove(entry);
  devices.insert(disclose(derive_device_entry_with_jubjub(
    kernel.self(), pk, device_epoch, ((use_counter + (1 as Uint<64>)) as Uint<64>)
  )));
  // The signer ground the challenge below the JubJub subgroup order
  // (§5.2), so the scalar image of the cast chain is canonical and matches
  // the scalar the signer used.
  const c = challenge as Field;
  assert(
    ecMulGenerator(sig_s as JubjubScalar) == ecAdd(sig_r, ecMul(pk, c as JubjubScalar)),
    "invalid signature"
  );
  auth_nonce = ((auth_nonce + (1 as Uint<64>)) as Uint<64>);
  bump_round();
}

circuit require_authorised_with_k256(
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
  challenge:   Bytes<32>,
  envelope:    Uint<8>,
): [] {
  require_live_k256_key(pk);
  const entry = disclose(derive_device_entry_with_k256(
    kernel.self(), pk, envelope, device_epoch, use_counter
  ));
  assert(devices.member(entry), "unknown device entry");
  devices.remove(entry);
  devices.insert(disclose(derive_device_entry_with_k256(
    kernel.self(), pk, envelope, device_epoch,
    ((use_counter + (1 as Uint<64>)) as Uint<64>)
  )));
  // The signature covers the envelope digest of the challenge, never the
  // challenge itself. The envelope cannot be equivocated per call: the
  // entry derivation above binds it, so a wrong id fails the membership
  // assert before any signature is examined. The verify interprets its
  // digest as a big-endian integer and reduces it mod the curve order
  // internally; both low-S and high-S signature forms are accepted (see
  // the malleability note in the header).
  const digest = envelope_digest(envelope, challenge);
  assert(
    secp256k1EcdsaVerify(digest, sig, pk),
    "invalid signature"
  );
  auth_nonce = ((auth_nonce + (1 as Uint<64>)) as Uint<64>);
  bump_round();
}

// Arm evm. The digest is computed by the CALLER (each gated export builds its
// own EIP-712 struct), and `address` is the caller's already-computed
// `secp256k1EthereumAddress(pk)` — the same value it put in the struct's `owner`
// field. Passing it rather than recomputing it here keeps one keccak per call;
// the obligation is local and holds for all seven call sites in this file, which
// are the only ones this internal chip has.
//
// Consequences of binding the entry to the address: presenting a point that does
// not hash to the enrolled address fails the membership assert, and so does a
// point of the k256 or jubjub arm (different DST), an unenrolled address, a
// stale epoch and a wrong use counter — all identically, before any signature is
// examined.
circuit require_authorised_with_evm(
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
  digest:      Bytes<32>,
  address:     Bytes<20>,
): [] {
  require_live_k256_key(pk);
  const entry = disclose(derive_device_entry_with_evm(
    kernel.self(), address, device_epoch, use_counter
  ));
  assert(devices.member(entry), "unknown device entry");
  devices.remove(entry);
  devices.insert(disclose(derive_device_entry_with_evm(
    kernel.self(), address, device_epoch,
    ((use_counter + (1 as Uint<64>)) as Uint<64>)
  )));
  // The signature covers the EIP-712 digest, never the challenge itself. The
  // verify interprets its digest as a big-endian integer and reduces it mod the
  // curve order internally; both low-S and high-S forms are accepted (see the
  // malleability note in the header).
  assert(
    secp256k1EcdsaVerify(digest, sig, pk),
    "invalid signature"
  );
  auth_nonce = ((auth_nonce + (1 as Uint<64>)) as Uint<64>);
  bump_round();
}

circuit bump_round(): [] {
  round = ((round + (1 as Uint<64>)) as Uint<64>);
}

// Unshielded mirror bookkeeping (MIP-0012 §5).

circuit credit_unshielded(color: Bytes<32>, amount: Uint<128>): [] {
  if (unshielded_balances.member(color)) {
    unshielded_balances.insert(
      color,
      ((unshielded_balances.lookup(color) + amount) as Uint<128>)
    );
  } else {
    unshielded_balances.insert(color, amount);
  }
}

circuit debit_unshielded(color: Bytes<32>, amount: Uint<128>): [] {
  assert(unshielded_balances.member(color), "no balance for color");
  const bal = unshielded_balances.lookup(color);
  assert(bal >= amount, "insufficient balance");
  unshielded_balances.insert(color, ((bal - amount) as Uint<128>));
}

// ── Custody chips (shared by every arm) ─────────────────────────────────────
//
// The MIP-0012 operation bodies, exactly once. Every `_with_<arm>` export
// below is challenge + seam chip + one of these. None of them touches
// auth_nonce or round — the seam chips own both.

// MIP-0012 §5: check and debit the mirror, then send to a user address.
circuit do_withdraw_unshielded(
  color:     Bytes<32>,
  amount:    Uint<128>,
  recipient: UserAddress,
): [] {
  const c = disclose(color);
  const a = disclose(amount);
  debit_unshielded(c, a);
  sendUnshielded(c, a, right<ContractAddress, UserAddress>(disclose(recipient)));
}

// MIP-0012 §6.2: inbox append without a coin claim (change-coin backfill).
circuit do_append_inbox(entry: Bytes<192>): [] {
  inbox.insert(inbox_count, disclose(entry));
  inbox_count = ((inbox_count + (1 as Uint<64>)) as Uint<64>);
}

// MIP-0012 §6.3: spend to a user's Zswap key. Change rule (§6.3,
// normative): sendShielded already routes change back to the contract as a
// live, self-owned output — the baseline realisation persists result.change
// directly, with no re-owning step. The surviving change description is
// returned to the caller through the transaction's communication
// commitment (not public); the client re-captures its mt_index and
// backfills the inbox via append_inbox (INV-4).
circuit do_withdraw_shielded(
  recipient: ZswapCoinPublicKey,
  amount:    Uint<128>,
  coin:      QualifiedShieldedCoinInfo,
): Maybe<ShieldedCoinInfo> {
  const result = sendShielded(
    disclose(coin),
    left<ZswapCoinPublicKey, ContractAddress>(disclose(recipient)),
    disclose(amount),
  );
  if (disclose(result.change.is_some)) {
    return some<ShieldedCoinInfo>(disclose(result.change.value));
  }
  return none<ShieldedCoinInfo>();
}

// MIP-0012 §6.6: the direct-transfer mode (see the exported circuits for
// the linking caveat). Returns [sent, change].
circuit do_withdraw_shielded_to_contract(
  recipient: ContractAddress,
  amount:    Uint<128>,
  coin:      QualifiedShieldedCoinInfo,
): [ShieldedCoinInfo, Maybe<ShieldedCoinInfo>] {
  const result = sendShielded(
    disclose(coin),
    right<ZswapCoinPublicKey, ContractAddress>(disclose(recipient)),
    disclose(amount),
  );
  if (disclose(result.change.is_some)) {
    return [disclose(result.sent), some<ShieldedCoinInfo>(disclose(result.change.value))];
  }
  return [disclose(result.sent), none<ShieldedCoinInfo>()];
}

// MIP-0012 §6.7: the single enc_key mutation site.
circuit do_rotate_enc_key(new_key: Bytes<32>): [] {
  enc_key = disclose(new_key);
}

// MIP-0013 §6: enrol an already-derived entry (any arm).
circuit do_add_device(new_entry: Bytes<32>): [] {
  const e = disclose(new_entry);
  assert(!devices.member(e), "device entry already present");
  devices.insert(e);
  device_count = ((device_count + (1 as Uint<8>)) as Uint<8>);
}

// MIP-0013 §6: remove a literal entry (any arm), last-device rule.
//
// AUTH-5 requires that a removal never leaves the account without a device
// that can authorise. A count alone cannot carry that guarantee here: entries
// arrive already derived (§6 cross-arm enrolment), so device_count counts
// entries rather than demonstrably usable keys, and an account holding one
// real device plus one mis-derived entry would satisfy device_count > 1 while
// the removal stranded it permanently.
//
// The rule is therefore anchored on the caller instead: caller_entry is the
// authorising device's post-roll entry, and it may not be the entry removed.
// Every removal is thus authorised by a device that has just proved itself in
// this same transaction and that survives the removal, so at least one usable
// device always remains — a guarantee the count could only approximate. The
// count check is retained as a cheap redundant floor. A mis-derived entry can
// still inflate device_count until removed; it can no longer cause a lockout.
circuit do_remove_device(entry: Bytes<32>, caller_entry: Bytes<32>): [] {
  const e = disclose(entry);
  assert(device_count > (1 as Uint<8>), "cannot remove last device");
  assert(e != disclose(caller_entry), "cannot remove the authorising device");
  assert(devices.member(e), "unknown device entry");
  devices.remove(e);
  device_count = ((device_count - (1 as Uint<8>)) as Uint<8>);
}

/// Parameter sanity for an offer, run BEFORE the seam so a malformed offer costs no signature
/// verification and reports what is actually wrong. Pure arithmetic on the caller's own arguments
/// plus the two fields of the witness coin the terms have to agree with; it reads no ledger state
/// and leaks nothing. Ported from AA-v3's `assertActionEnvelope` selector-6 block, with the
/// pooled-balance guards replaced by the two held-coin checks this stateless model needs instead.
///
/// NO CONTRACT TAKER (`recipient_kind == 2`), deliberately, and refused HERE rather than by the
/// ledger. A contract-addressed shielded payout is accepted only if the recipient contract claims
/// receipt in the SAME transaction — `commitments == claimed_shielded_receives` is an EQUALITY — and
/// a taker composing its own transaction cannot reach inside the maker's call to claim one. Such an
/// offer would be unsettleable by construction, and the maker would learn it only after minutes of
/// proving, from a numeric node error. The range check is kept ahead of the refusal so an
/// out-of-range kind still reports itself as out of range, and so this reads as what it is: a
/// capability switched off, not a malformed field.
export pure circuit assert_open_swap_terms(
  give_color:     Bytes<32>,
  give_amount:    Uint<128>,
  recipient_kind: Uint<8>,
  recipient:      Bytes<32>,
  want:           ShieldedCoinInfo,
  coin_color:     Bytes<32>,
  coin_value:     Uint<128>,
): [] {
  assert(give_amount > (0 as Uint<128>), "swap must give a positive amount");
  assert(want.value > (0 as Uint<128>), "swap must want a positive amount");
  // Equal colours would let a maker "swap" a colour for itself, which is a withdrawal wearing an
  // offer's clothes: the taker would fund the deficit and sweep the surplus of the SAME colour and
  // the account would end up exactly where it started, minus nothing the taker paid for.
  assert(give_color != want.color, "swap legs must be different colours");
  assert(recipient_kind <= (2 as Uint<8>), "swap recipient kind is invalid");
  assert(recipient_kind <= (1 as Uint<8>), "swap to a contract taker is not supported");
  if (recipient_kind == (0 as Uint<8>)) {
    assert(recipient == default<Bytes<32>>, "open swap recipient must be zero");
  } else {
    assert(recipient != default<Bytes<32>>, "named swap recipient must be nonzero");
  }
  // The witness is keyed by colour, so an honest client cannot return a coin of another colour; a
  // DISHONEST one could, and the open shape builds its change coin from the input coin's own fields.
  // Asserting the equality is what makes the offer's declared give colour the colour that actually
  // moves, rather than a label.
  assert(coin_color == give_color, "held coin colour does not match the give colour");
  assert(coin_value >= give_amount, "held coin is smaller than the give amount");
}

/// The standard library's change rule, exported so a client can compute the surviving coin's nonce
/// BEFORE the call instead of reading it from the result afterwards.
///
/// Every other spend on this contract lets the client backfill its change entry with a later
/// `append_inbox`, so it never needs to predict the nonce. An offer cannot: its change entry is an
/// argument, bound in the challenge and appended inside the same call, so the maker must know the
/// coin at signing time. `pure`, therefore free — and it is the CONTRACT's own answer, not a client
/// transcription of a rule it cannot see (`src/tests/swap-shapes-offline.ts` asserts on every run
/// that the coin this predicts is the coin the circuit actually creates, for both shapes).
export pure circuit swap_change_nonce(coin_nonce: Bytes<32>): Bytes<32> {
  return evolveNonce(2, coin_nonce);
}

/// The offer deadline (Q8-B). ZERO MEANS NO DEADLINE, and this is the only circuit in the contract
/// with one at all — every other operation relies on `auth_nonce` alone, which is enough exactly
/// because a signature there is spent immediately.
///
/// The ledger op is GUARDED. A circuit has no control flow, but a guard over a PUBLIC value does
/// suppress the ledger operations inside it, and it must: `blockTimeLt(0)` would bound the
/// transaction to blocks with a timestamp below zero, i.e. to no block ever, so an offer with no
/// deadline would be unsubmittable.
///
/// There is deliberately NO lower bound and therefore NO subtraction. AA-v3 pairs
/// `blockTimeLt(validUntil)` with `blockTimeGte(validUntil - 3600)` to cap the horizon at an hour,
/// and its own header records that the subtraction underflows on every call that does not reach it,
/// so the value may never be routed into a hash or a cast. An offer's whole purpose is to stay live
/// until a taker finds it, so an hour cap would be wrong here — and dropping it removes that hazard
/// outright instead of clamping around it. The cost of having no lower bound is that the deadline
/// bounds only the END of the window; nothing here needs it to bound the start.
circuit assert_offer_live(valid_until: Uint<64>): [] {
  const deadline = disclose(valid_until);
  if (deadline != (0 as Uint<64>)) {
    assert(blockTimeLt(deadline), "offer authorisation has expired");
  }
}

// MIP-0012 §6.3, extended: THE OPEN ZSWAP OFFER.
//
// One proved call fuses a GIVE leg (a held coin leaves, in one of two shapes) and a WANT leg (a coin
// this transaction does not fund is claimed into custody). The want leg is what makes the call
// UNBALANCED — a deficit of `want.value` of `want.color` at the guaranteed segment — and THAT
// DEFICIT IS THE OFFER. The maker proves the call and stops: no balancing, no signing, no DUST, no
// submission. A taker who never knew the maker balances it with its own coins and submits one
// atomic transaction, so the swap settles by construction rather than by two calls that could
// diverge.
//
// `recipient_kind` picks between two genuinely different mechanisms, not a cosmetic flag:
//
//   KIND 0, THE OPEN OFFER — the held coin is consumed as a zswap INPUT and its nullifier claimed,
//       and the only output created is the change back to this contract. The given value has NO
//       OUTPUT AT ALL: it stands as a positive imbalance addressed to nobody, which any taker's
//       stock balancer sweeps. That is what makes the offer usable by a holder whose keys the maker
//       never knew — and why this contract transcribes the standard library's private coin
//       commitment and nullifier (`modules/ZswapPrimitives.compact`): `sendShielded` is the only
//       exported route to a zswap input and it always creates an output for the value it moves.
//
//   KIND 1, THE NAMED OFFER — an output for exactly the given value is created for a named coin
//       public key, so the give leg is INTERNALLY BALANCED and the call's only imbalance is the
//       want-side deficit.
//       Naming a throwaway key whose secret ships with the offer turns this into a bearer offer,
//       with no contract support beyond this branch.
//
//   KIND 2, a CONTRACT taker, is refused in `assert_open_swap_terms` — see the note there.
//
// STATELESS, like every other spend here: the coin comes from the `held_coin` witness and leaves as
// zswap inputs and outputs; the only ledger writes are the inbox appends below and the seam's own
// counters. There is no pool to re-pool into, which is the one structural difference from the AA-v3
// circuit this is ported from.
//
// Returns the surviving change coin (none when the held coin is spent exactly), on the private
// channel, exactly as `do_withdraw_shielded` does. The client needs its `nonce` BEFORE the call as
// well — that is what `change_entry` is sealed to — so the same value is available ahead of time
// through the free oracle `swap_change_nonce`.
circuit do_open_swap(
  coin:           QualifiedShieldedCoinInfo,
  give_amount:    Uint<128>,
  recipient_kind: Uint<8>,
  recipient:      Bytes<32>,
  want:           ShieldedCoinInfo,
  want_entry:     Bytes<192>,
  change_entry:   Bytes<192>,
): Maybe<ShieldedCoinInfo> {
  const self_addr = kernel.self();
  const self_rcpt = right<ZswapCoinPublicKey, ContractAddress>(self_addr);
  const c    = disclose(coin);
  const give = disclose(give_amount);
  const kind = disclose(recipient_kind);

  // THE CLAMP. `assert_open_swap_terms` has already forced `c.value >= give`, so `safe_give == give`
  // on every run that reaches this line and the clamp is the identity. It exists for the runs that
  // do NOT reach it: a circuit has no control flow, so the guards below suppress their EFFECTS and
  // ASSERTS but not their ARITHMETIC, and an unclamped `c.value - give` would be a negative field
  // element, and both output coins below encode it as a `Uint<128>`. The witness VM refuses to
  // encode that ("inputs did not match alignment"), which would cost the circuit its provable runs
  // entirely. This is the clamp AA-v3's header warns about, kept.
  const safe_give    = (c.value >= give ? give : 0) as Uint<128>;
  const change_value = (c.value - safe_give) as Uint<128>;
  const has_change   = change_value > 0;

  // The surviving coin, named once and used by both shapes, with ONE rule: `evolveNonce(2, …)`, the
  // same index the standard library reserves for a change coin and the same rule AA-v3's open shape
  // used. The client reproduces it before the call through the free oracle `swap_change_nonce`, and
  // `src/tests/swap-shapes-offline.ts` asserts the two agree on every run.
  const change_coin = ShieldedCoinInfo {
    nonce: evolveNonce(2, c.nonce),
    color: c.color,
    value: change_value
  };

  // THE GIVE LEG. The input and its nullifier are SHARED by both shapes and hoisted out of the
  // select: every offer spends the held coin, and only what happens to the given value differs.
  //
  // The named shape does NOT call `sendShielded`, deliberately. The library's change coin takes its
  // nonce from a DIFFERENT rule than `evolveNonce` — the generated code hashes a separator whose
  // string already ends in `/2` over the nonce alone, where `evolveNonce(2, n)` hashes a separator,
  // an index and the nonce, and the two are not equal. A circuit that used `sendShielded` for one
  // shape and built its own change coin for the other would therefore have TWO change rules, and a
  // client that has to seal the change entry BEFORE the call could only predict one of them. So both
  // shapes build their outputs here, from one rule, and the offline suite pins it. (This is a
  // departure from the AA-v3 circuit, which had a pool to re-pool into and read the surviving coin
  // from the library's own result; see the questions file, Q37.)
  createZswapInput(c);
  kernel.claimZswapNullifier(zswapCoinNullifier(dropMerkleIndex(c), self_addr));

  if (kind != 0) {
    // NAMED: an output addressed to the recipient's coin public key, for exactly the given value.
    // Only a SPEND is claimed — a receive would assert this contract owns it, and it does not. The
    // payout's nonce evolves from the input coin's under index 1, the change's under index 2, so the
    // two outputs of one call can never collide.
    const payout = ShieldedCoinInfo {
      nonce: evolveNonce(1, c.nonce),
      color: c.color,
      value: safe_give
    };
    const payout_rcpt =
      left<ZswapCoinPublicKey, ContractAddress>(ZswapCoinPublicKey { bytes: disclose(recipient) });
    createZswapOutput(payout, payout_rcpt);
    kernel.claimZswapCoinSpend(zswapCoinCommitment(payout, payout_rcpt));
  }
  // OPEN (kind 0) creates NO output for the given value at all — that omission IS the open offer.

  if (has_change) {
    createZswapOutput(change_coin, self_rcpt);
    const cm = zswapCoinCommitment(change_coin, self_rcpt);
    kernel.claimZswapCoinSpend(cm);
    kernel.claimZswapCoinReceive(cm);
  }

  // THE WANT LEG, both shapes. `receiveShielded` creates an output this transaction does not fund —
  // the deficit that IS the offer — and must precede nothing else here: it is what allocates the
  // coin's Merkle-tree index.
  receiveShielded(disclose(want));

  // The inbox, in a FIXED order so a client can predict the ordinals it must walk: the change entry
  // first when change exists, then the want entry. Both are opaque 192-byte containers the client
  // sealed to this account's encryption key and the challenge bound in full.
  if (has_change) {
    do_append_inbox(change_entry);
  }
  do_append_inbox(want_entry);

  if (has_change) {
    return some<ShieldedCoinInfo>(change_coin);
  }
  return none<ShieldedCoinInfo>();
}

// ── Unshielded custody (MIP-0012 §5) ────────────────────────────────────────

// Permissionless: anyone may fund the account. Increments round (§4).
export circuit deposit_unshielded(color: Bytes<32>, amount: Uint<128>): [] {
  const c = disclose(color);
  const a = disclose(amount);
  receiveUnshielded(c, a);
  credit_unshielded(c, a);
  bump_round();
}

// Authorised withdrawal to a user address.

export circuit withdraw_unshielded_with_jubjub(
  color:       Bytes<32>,
  amount:      Uint<128>,
  recipient:   UserAddress,
  pk:          JubjubPoint,
  use_counter: Uint<64>,
  sig_r:       JubjubPoint,
  sig_s:       Field,
  grind_nonce: Uint<64>,
): [] {
  const challenge = challenge_withdraw_unshielded_with_jubjub(
    kernel.self(), sig_r, pk, color, amount, recipient, auth_nonce, grind_nonce
  );
  require_authorised_with_jubjub(pk, use_counter, sig_r, sig_s, challenge);
  do_withdraw_unshielded(color, amount, recipient);
}

export circuit withdraw_unshielded_with_k256(
  color:       Bytes<32>,
  amount:      Uint<128>,
  recipient:   UserAddress,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
  envelope:    Uint<8>,
): [] {
  const challenge = challenge_withdraw_unshielded_with_k256(
    kernel.self(), pk, color, amount, recipient, auth_nonce
  );
  require_authorised_with_k256(pk, use_counter, sig, challenge, envelope);
  do_withdraw_unshielded(color, amount, recipient);
}

export circuit withdraw_unshielded_with_evm(
  color:       Bytes<32>,
  amount:      Uint<128>,
  recipient:   UserAddress,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
): [] {
  const address = secp256k1EthereumAddress(pk);
  const challenge = challenge_withdraw_unshielded_with_evm(
    kernel.self(), address, color, amount, recipient, auth_nonce
  );
  const digest = evm_digest_withdraw_unshielded(
    kernel.self().bytes, evm_domain_salt, address, auth_nonce,
    color, amount, recipient.bytes, challenge
  );
  require_authorised_with_evm(pk, use_counter, sig, digest, address);
  do_withdraw_unshielded(color, amount, recipient);
}

// ── Shielded custody, stateless (MIP-0012 §6) ───────────────────────────────

// Permissionless deposit (§6.2): claims the coin for the contract and
// appends the depositor-encrypted InboxEntry. The contract cannot verify
// the correspondence between coin and entry (S3); honest clients detect
// mismatches at discovery by recomputing the commitment against chain data.
export circuit deposit_shielded(coin: ShieldedCoinInfo, entry: Bytes<192>): [] {
  receiveShielded(disclose(coin));
  inbox.insert(inbox_count, disclose(entry));
  inbox_count = ((inbox_count + (1 as Uint<64>)) as Uint<64>);
  bump_round();
}

// Inbox append without a coin claim (§6.2): change-coin backfill. Gated
// behind the seam per the MAY of §6.2 (S9 spam defence) — backfill is
// always performed by the owner's own client, so gating loses nothing.

export circuit append_inbox_with_jubjub(
  entry:       Bytes<192>,
  pk:          JubjubPoint,
  use_counter: Uint<64>,
  sig_r:       JubjubPoint,
  sig_s:       Field,
  grind_nonce: Uint<64>,
): [] {
  const challenge = challenge_append_inbox_with_jubjub(
    kernel.self(), sig_r, pk, entry, auth_nonce, grind_nonce
  );
  require_authorised_with_jubjub(pk, use_counter, sig_r, sig_s, challenge);
  do_append_inbox(entry);
}

export circuit append_inbox_with_k256(
  entry:       Bytes<192>,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
  envelope:    Uint<8>,
): [] {
  const challenge = challenge_append_inbox_with_k256(
    kernel.self(), pk, entry, auth_nonce
  );
  require_authorised_with_k256(pk, use_counter, sig, challenge, envelope);
  do_append_inbox(entry);
}

// The entry enters the EIP-712 struct as its keccak (one word per field), and
// the challenge binds all 192 bytes, so the entry behind the hash is pinned
// twice over.
export circuit append_inbox_with_evm(
  entry:       Bytes<192>,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
): [] {
  const address = secp256k1EthereumAddress(pk);
  const challenge = challenge_append_inbox_with_evm(
    kernel.self(), address, entry, auth_nonce
  );
  const digest = evm_digest_append_inbox(
    kernel.self().bytes, evm_domain_salt, address, auth_nonce,
    keccak256<Bytes<192>>(entry), challenge
  );
  require_authorised_with_evm(pk, use_counter, sig, digest, address);
  do_append_inbox(entry);
}

// Authorised spend to a user's Zswap key (§6.3). The coin description
// enters through the held_coin witness, never from ledger state. The
// witness is invoked before the challenge so its returned value enters the
// challenge (AUTH-10): the signature authorises spending exactly this
// qualified coin, not any coin of this color.

export circuit withdraw_shielded_with_jubjub(
  recipient:   ZswapCoinPublicKey,
  color:       Bytes<32>,
  amount:      Uint<128>,
  pk:          JubjubPoint,
  use_counter: Uint<64>,
  sig_r:       JubjubPoint,
  sig_s:       Field,
  grind_nonce: Uint<64>,
): Maybe<ShieldedCoinInfo> {
  const coin = held_coin(color);
  const challenge = challenge_withdraw_shielded_with_jubjub(
    kernel.self(), sig_r, pk, recipient, color, amount, coin, auth_nonce, grind_nonce
  );
  require_authorised_with_jubjub(pk, use_counter, sig_r, sig_s, challenge);
  return do_withdraw_shielded(recipient, amount, coin);
}

export circuit withdraw_shielded_with_k256(
  recipient:   ZswapCoinPublicKey,
  color:       Bytes<32>,
  amount:      Uint<128>,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
  envelope:    Uint<8>,
): Maybe<ShieldedCoinInfo> {
  const coin = held_coin(color);
  const challenge = challenge_withdraw_shielded_with_k256(
    kernel.self(), pk, recipient, color, amount, coin, auth_nonce
  );
  require_authorised_with_k256(pk, use_counter, sig, challenge, envelope);
  return do_withdraw_shielded(recipient, amount, coin);
}

export circuit withdraw_shielded_with_evm(
  recipient:   ZswapCoinPublicKey,
  color:       Bytes<32>,
  amount:      Uint<128>,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
): Maybe<ShieldedCoinInfo> {
  // The witness runs BEFORE the challenge, so its value enters the challenge
  // (AUTH-10) and the signature authorises spending exactly this qualified coin
  // — the coin the wallet never sees and cannot display.
  const coin = held_coin(color);
  const address = secp256k1EthereumAddress(pk);
  const challenge = challenge_withdraw_shielded_with_evm(
    kernel.self(), address, recipient, color, amount, coin, auth_nonce
  );
  const digest = evm_digest_withdraw_shielded(
    kernel.self().bytes, evm_domain_salt, address, auth_nonce,
    color, amount, recipient.bytes, challenge
  );
  require_authorised_with_evm(pk, use_counter, sig, digest, address);
  return do_withdraw_shielded(recipient, amount, coin);
}

// Authorised contract-recipient spend — the direct-transfer mode of §6.6
// (linking accepted). The output MUST be claimed by the receiving
// contract's deposit path in the same client-composed transaction; a
// contract-addressed output carries that address in cleartext, so a direct
// payment publishes the pair of accounts. Conforming clients MUST default
// to one-hop routing and produce this only by deliberate per-payment
// choice. Onward change handling is identical to the baseline circuit's.
//
// Returns [sent, change]: the composing client passes `sent` (the stdlib
// SendResult.sent coin — its nonce is the deterministic evolution of the
// input coin's) to the receiving contract's deposit_shielded claim, and
// persists `change` per the surviving-coin rule. Both travel privately in
// the communication commitment.

export circuit withdraw_shielded_to_contract_with_jubjub(
  recipient:   ContractAddress,
  color:       Bytes<32>,
  amount:      Uint<128>,
  pk:          JubjubPoint,
  use_counter: Uint<64>,
  sig_r:       JubjubPoint,
  sig_s:       Field,
  grind_nonce: Uint<64>,
): [ShieldedCoinInfo, Maybe<ShieldedCoinInfo>] {
  const coin = held_coin(color);
  const challenge = challenge_withdraw_shielded_to_contract_with_jubjub(
    kernel.self(), sig_r, pk, recipient, color, amount, coin, auth_nonce, grind_nonce
  );
  require_authorised_with_jubjub(pk, use_counter, sig_r, sig_s, challenge);
  return do_withdraw_shielded_to_contract(recipient, amount, coin);
}

export circuit withdraw_shielded_to_contract_with_k256(
  recipient:   ContractAddress,
  color:       Bytes<32>,
  amount:      Uint<128>,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
  envelope:    Uint<8>,
): [ShieldedCoinInfo, Maybe<ShieldedCoinInfo>] {
  const coin = held_coin(color);
  const challenge = challenge_withdraw_shielded_to_contract_with_k256(
    kernel.self(), pk, recipient, color, amount, coin, auth_nonce
  );
  require_authorised_with_k256(pk, use_counter, sig, challenge, envelope);
  return do_withdraw_shielded_to_contract(recipient, amount, coin);
}

export circuit withdraw_shielded_to_contract_with_evm(
  recipient:   ContractAddress,
  color:       Bytes<32>,
  amount:      Uint<128>,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
): [ShieldedCoinInfo, Maybe<ShieldedCoinInfo>] {
  const coin = held_coin(color);
  const address = secp256k1EthereumAddress(pk);
  const challenge = challenge_withdraw_shielded_to_contract_with_evm(
    kernel.self(), address, recipient, color, amount, coin, auth_nonce
  );
  const digest = evm_digest_withdraw_shielded_to_contract(
    kernel.self().bytes, evm_domain_salt, address, auth_nonce,
    color, amount, recipient.bytes, challenge
  );
  require_authorised_with_evm(pk, use_counter, sig, digest, address);
  return do_withdraw_shielded_to_contract(recipient, amount, coin);
}

// ── Encryption-key lifecycle (MIP-0012 §6.7) ────────────────────────────────
//
// Exactly one way to change enc_key. After rotation the client SHOULD
// re-encrypt held-coin descriptions into fresh inbox entries under the new
// key so the inbox walk succeeds with the new secret alone.

export circuit rotate_enc_key_with_jubjub(
  new_key:     Bytes<32>,
  pk:          JubjubPoint,
  use_counter: Uint<64>,
  sig_r:       JubjubPoint,
  sig_s:       Field,
  grind_nonce: Uint<64>,
): [] {
  const challenge = challenge_rotate_enc_key_with_jubjub(
    kernel.self(), sig_r, pk, new_key, auth_nonce, grind_nonce
  );
  require_authorised_with_jubjub(pk, use_counter, sig_r, sig_s, challenge);
  do_rotate_enc_key(new_key);
}

export circuit rotate_enc_key_with_k256(
  new_key:     Bytes<32>,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
  envelope:    Uint<8>,
): [] {
  const challenge = challenge_rotate_enc_key_with_k256(
    kernel.self(), pk, new_key, auth_nonce
  );
  require_authorised_with_k256(pk, use_counter, sig, challenge, envelope);
  do_rotate_enc_key(new_key);
}

export circuit rotate_enc_key_with_evm(
  new_key:     Bytes<32>,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
): [] {
  const address = secp256k1EthereumAddress(pk);
  const challenge = challenge_rotate_enc_key_with_evm(
    kernel.self(), address, new_key, auth_nonce
  );
  const digest = evm_digest_rotate_enc_key(
    kernel.self().bytes, evm_domain_salt, address, auth_nonce, new_key, challenge
  );
  require_authorised_with_evm(pk, use_counter, sig, digest, address);
  do_rotate_enc_key(new_key);
}

// ── Device lifecycle (MIP-0013 §6) ──────────────────────────────────────────
//
// Any active device of any arm is sufficient to authorise (1-of-n at the
// contract surface). On the jubjub arm, threshold policies live behind a
// single device entry whose key is a FROST committee's joint key (MIP-0013
// §7) — this contract neither knows nor cares. ECDSA thresholdisation is
// deliberately out of scope for the k256 arm (it is one of MIP-0013 R2's
// grounds for rejecting ECDSA as the standard scheme).
//
// The NEW device is passed as its derived entry, computed client-side with
// the exported derive_device_entry_with_<arm> circuit of the NEW device's
// arm — so the authorising arm and the enrolled arm are independent, and
// enrolling a device of a future arm needs no change here. The entry is a
// collision-resistant commitment to the new key, its arm, the epoch, and
// the use counter, so the approval covers all four. The contract cannot
// inspect the entry's preimage: clients MUST derive it with the CURRENT
// device_epoch and use counter 0.
//
// Be precise about what a mis-derived entry does, because the guarantee is
// weaker than "inert" along two of its three dimensions.
//
//   address  An entry bound to a different contract address can never match a
//            seam recomputation. Genuinely dead weight.
//   counter  An entry at the CURRENT epoch and use counter k > 0 is NOT dead:
//            the seam recomputes against the caller-supplied use_counter, so
//            it authorises as soon as its key signs with use_counter = k.
//   epoch    An entry at a PAST epoch is dead. An entry at a FUTURE epoch is
//            dormant, not dead, and this is the sharp edge: nothing here binds
//            device_epoch, so any authorised device can enrol an entry derived
//            at device_epoch + 1. It matches nothing today and goes live the
//            moment the epoch advances.
//
// That last case is a live constraint on the MIP-0013 §8 recovery seam, which
// is the only thing that will ever bump device_epoch. AUTH-6 exists so that a
// bump revokes a compromised device set WITHOUT enumerating it, and a
// pre-planted future-epoch entry defeats exactly that: the device being
// evicted survives its own eviction. **A recovery seam added here MUST clear
// the device set as part of the bump rather than rely on entries going
// stale** (equivalently, entries must be stored stamped with the epoch the
// CONTRACT observed at enrolment, rather than one carried in a preimage the
// contract cannot inspect). See README erratum 7.
//
// None of these can strand the account, because a removal may not remove the
// device that authorised it (AUTH-5, do_remove_device), and all of them count
// toward device_count until removed.
//
// LIVENESS IS NOT THE PROBLEM HERE; REVOCATION IS. Nothing constrains a
// device to exactly one live entry, so an enrolled device can enrol a
// SECOND entry for its OWN key. The seam consumes its current entry and
// inserts the successor, then this circuit inserts the planted one, and the
// device is live at two counters. remove_device retires one set ELEMENT, and
// resolving which element belongs to a device returns the first live counter
// found, so a revocation removes one and the device keeps authorising on the
// other. Measured on-node in src/tests/probe-revocation.ts.
//
// Deriving the entry in-circuit from new_pk does NOT fix this: a device whose
// chain has advanced past counter 0 has left that entry vacant, so enrolling
// its own key plants exactly the element such a derivation emits. The probe
// exercises both shapes and both bypass. The contract cannot decide "this key
// is already enrolled" over the current ledger shape (it holds an opaque
// entry, or a key whose other entries it cannot search for), and stating the
// rule as a client obligation (S11) does not help, because the party it binds
// is the adversary in this threat model. Closing it needs a per-device
// identity the CONTRACT maintains, which is a ledger-schema change and so a
// redeploy: see README erratum 8, which carries the shape.

export circuit add_device_with_jubjub(
  new_entry:   Bytes<32>,
  pk:          JubjubPoint,
  use_counter: Uint<64>,
  sig_r:       JubjubPoint,
  sig_s:       Field,
  grind_nonce: Uint<64>,
): [] {
  const challenge = challenge_add_device_with_jubjub(
    kernel.self(), sig_r, pk, new_entry, auth_nonce, grind_nonce
  );
  require_authorised_with_jubjub(pk, use_counter, sig_r, sig_s, challenge);
  do_add_device(new_entry);
}

export circuit add_device_with_k256(
  new_entry:   Bytes<32>,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
  envelope:    Uint<8>,
): [] {
  const challenge = challenge_add_device_with_k256(
    kernel.self(), pk, new_entry, auth_nonce
  );
  require_authorised_with_k256(pk, use_counter, sig, challenge, envelope);
  do_add_device(new_entry);
}

export circuit add_device_with_evm(
  new_entry:   Bytes<32>,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
): [] {
  const address = secp256k1EthereumAddress(pk);
  const challenge = challenge_add_device_with_evm(
    kernel.self(), address, new_entry, auth_nonce
  );
  const digest = evm_digest_add_device(
    kernel.self().bytes, evm_domain_salt, address, auth_nonce, new_entry, challenge
  );
  require_authorised_with_evm(pk, use_counter, sig, digest, address);
  do_add_device(new_entry);
}

// Removes a device's CURRENT entry, supplied as the literal set element
// (MIP-0013 §6): removing a lost device requires its public key and
// current use counter, recovered from the client roster or the S11
// rescan. Entry-typed, so a device of either arm removes a device of
// either arm.

export circuit remove_device_with_jubjub(
  entry:       Bytes<32>,
  pk:          JubjubPoint,
  use_counter: Uint<64>,
  sig_r:       JubjubPoint,
  sig_s:       Field,
  grind_nonce: Uint<64>,
): [] {
  const challenge = challenge_remove_device_with_jubjub(
    kernel.self(), sig_r, pk, entry, auth_nonce, grind_nonce
  );
  require_authorised_with_jubjub(pk, use_counter, sig_r, sig_s, challenge);
  // The seam has rolled the caller to use_counter + 1; that entry is the one
  // it must not remove (removing its pre-roll entry already fails membership).
  do_remove_device(entry, derive_device_entry_with_jubjub(
    kernel.self(), pk, device_epoch, ((use_counter + (1 as Uint<64>)) as Uint<64>)
  ));
}

export circuit remove_device_with_k256(
  entry:       Bytes<32>,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
  envelope:    Uint<8>,
): [] {
  const challenge = challenge_remove_device_with_k256(
    kernel.self(), pk, entry, auth_nonce
  );
  require_authorised_with_k256(pk, use_counter, sig, challenge, envelope);
  // As above: the caller's post-roll entry is off limits.
  do_remove_device(entry, derive_device_entry_with_k256(
    kernel.self(), pk, envelope, device_epoch,
    ((use_counter + (1 as Uint<64>)) as Uint<64>)
  ));
}

export circuit remove_device_with_evm(
  entry:       Bytes<32>,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
): [] {
  const address = secp256k1EthereumAddress(pk);
  const challenge = challenge_remove_device_with_evm(
    kernel.self(), address, entry, auth_nonce
  );
  const digest = evm_digest_remove_device(
    kernel.self().bytes, evm_domain_salt, address, auth_nonce, entry, challenge
  );
  require_authorised_with_evm(pk, use_counter, sig, digest, address);
  // As above: the caller's post-roll entry is off limits.
  do_remove_device(entry, derive_device_entry_with_evm(
    kernel.self(), address, device_epoch,
    ((use_counter + (1 as Uint<64>)) as Uint<64>)
  ));
}

// ── The open ZSwap offer, one gated export per arm ──────────────────────────
//
// Spec 00034 User Story 2 / FR-006–FR-008. The custody body is `do_open_swap` above; what follows is
// the same seam mechanics every other gated circuit uses — witness first (AUTH-10), sanity, deadline,
// challenge, verification, chip — with two additions that exist only here.
//
// FIRST, `valid_until`. Every other operation on every arm relies on `auth_nonce` alone (AUTH-2): a
// signature never expires, but at most one executes. An offer breaks the assumption that makes that
// enough — it is a proved call that sits published until a STRANGER settles it, so "at most one
// executes" is true while "it executes when the maker still wants it to" is not. `valid_until` is
// therefore a per-offer, zero-means-none deadline, bound in both the challenge and the EIP-712
// struct, and it is the only place in this contract where ledger time is read at all.
//
// SECOND, the inbox entries are ARGUMENTS. Every other spend leaves the client to backfill its
// change entry with a second call (`append_inbox`); an offer cannot, because the maker is gone by
// the time the call executes and a second signed call would invalidate the pending offer (see the
// concurrency note below). So both entries — for the change and for the wanted coin — are computed
// client-side before proving, passed in, and appended inside the same call.
//
// ONE LIVE OFFER PER ACCOUNT (Q7, accepted for this project and documented rather than fixed). The
// seam consumes the acting device's current entry and binds `auth_nonce`; a pending offer is a
// proved call against a specific `auth_nonce` and a specific entry, so ANY other gated call from ANY
// device on this account — including a second offer — makes it stale forever. A market maker wanting
// concurrent offers needs one account per offer, or a seam change that is out of scope here.

export circuit open_swap_shielded_with_jubjub(
  give_color:     Bytes<32>,
  give_amount:    Uint<128>,
  recipient_kind: Uint<8>,
  recipient:      Bytes<32>,
  want:           ShieldedCoinInfo,
  want_entry:     Bytes<192>,
  change_entry:   Bytes<192>,
  valid_until:    Uint<64>,
  pk:             JubjubPoint,
  use_counter:    Uint<64>,
  sig_r:          JubjubPoint,
  sig_s:          Field,
  grind_nonce:    Uint<64>,
): Maybe<ShieldedCoinInfo> {
  const coin = held_coin(give_color);
  assert_open_swap_terms(
    give_color, give_amount, recipient_kind, recipient, want, coin.color, coin.value
  );
  assert_offer_live(valid_until);
  const challenge = challenge_open_swap_shielded_with_jubjub(
    kernel.self(), sig_r, pk, give_color, give_amount, recipient_kind, recipient, want,
    want_entry, change_entry, valid_until, coin, auth_nonce, grind_nonce
  );
  require_authorised_with_jubjub(pk, use_counter, sig_r, sig_s, challenge);
  return do_open_swap(coin, give_amount, recipient_kind, recipient, want, want_entry, change_entry);
}

export circuit open_swap_shielded_with_evm(
  give_color:     Bytes<32>,
  give_amount:    Uint<128>,
  recipient_kind: Uint<8>,
  recipient:      Bytes<32>,
  want:           ShieldedCoinInfo,
  want_entry:     Bytes<192>,
  change_entry:   Bytes<192>,
  valid_until:    Uint<64>,
  pk:             Secp256k1Point,
  use_counter:    Uint<64>,
  sig:            Secp256k1EcdsaSignature,
): Maybe<ShieldedCoinInfo> {
  // The witness runs BEFORE the challenge, so the qualified coin the spend will consume enters the
  // challenge (AUTH-10). On this arm that matters twice over: the wallet is shown the offer's TERMS
  // (colours, amounts, recipient, deadline) and cannot be shown the coin, so the coin is pinned by
  // the challenge the wallet signs as one field of the struct.
  const coin = held_coin(give_color);
  assert_open_swap_terms(
    give_color, give_amount, recipient_kind, recipient, want, coin.color, coin.value
  );
  assert_offer_live(valid_until);
  const address = secp256k1EthereumAddress(pk);
  const challenge = challenge_open_swap_shielded_with_evm(
    kernel.self(), address, give_color, give_amount, recipient_kind, recipient, want,
    want_entry, change_entry, valid_until, coin, auth_nonce
  );
  const digest = evm_digest_open_swap_shielded(
    kernel.self().bytes, evm_domain_salt, address, auth_nonce,
    give_color, give_amount, recipient_kind, recipient,
    want.nonce, want.color, want.value, valid_until, challenge
  );
  require_authorised_with_evm(pk, use_counter, sig, digest, address);
  return do_open_swap(coin, give_amount, recipient_kind, recipient, want, want_entry, change_entry);
}


// ── The ERC20 bridge (project 00034 PR-G; spec User Stories 5 and 7, FR-021, FR-027) ────
//
// Five circuits, two device-gated and three permissionless, driving the witness-free ERC20
// vault fork by cross-contract call. The asymmetry is the design, not an oversight:
//
//   START is gated because it commits this account to an ERC20 and an amount and, above
//   all, because the EVM transaction parameters it signs SPEND GAS from an MPC-derived
//   Ethereum account. A relayer that could choose them could drain that account.
//
//   SETTLE is permissionless because the vault verifies the MPC's attestation in-circuit
//   against the response key it pinned at initialise, and because the only recipient a
//   settle can pay was pinned when the start ran (`right(kernel.self())` — this account).
//   Whoever submits the transaction, the coin can only land here. That is what lets a
//   relayer finish a deposit the owner started, and it is why the owner's device signature
//   is not needed twice for one round trip.
//
// A deposit is therefore TWO Midnight transactions with an MPC round trip in between, and
// a withdraw is two more. The round trip cannot be collapsed: nothing on Midnight can wait
// for an Ethereum transaction inside one proof.
//
// THE CALLEE RULE (Gate 0, question Q21b) governs every recipient here. A callee's shielded
// output only survives when the transaction's ROOT claims it in the same tree — a callee
// paying a wallet key is refused by the node (ledger 213). The vault is the callee in all
// five of these calls, so every mint it makes must be addressed to THIS account and claimed
// by `receiveShielded` in the same circuit. The vault cannot check that itself (Compact has
// no caller introspection), which makes it the CALLER'S obligation: `right(kernel.self())`
// is passed as the recipient at both starts and is not a parameter anyone can influence.

// Start a deposit: the client has already told the user an Ethereum address derived from
// `depositPath(right(this account))`, and the user has funded it with the ERC20 and gas ETH.
// This call asks the MPC to sign `transfer(vault, amount)` FROM that derived address.
//
// One transaction, three contract calls: account -> vault.startDeposit -> the Signet
// singleton's signBidirectional (the vault makes the second hop). No value moves on
// Midnight here and no account state changes beyond the seam's own (`auth_nonce`, `round`,
// the rolled device entry).
export circuit bridge_deposit_start_with_evm(
  erc20:            Bytes<20>,
  amount:           Uint<128>,
  evm_nonce:        Uint<64>,
  gas_limit:        Uint<64>,
  max_fee:          Uint<128>,
  max_priority_fee: Uint<128>,
  key_version:      Uint<8>,
  pk:               Secp256k1Point,
  use_counter:      Uint<64>,
  sig:              Secp256k1EcdsaSignature,
): [] {
  const address = secp256k1EthereumAddress(pk);
  const challenge = challenge_bridge_deposit_start_with_evm(
    kernel.self(), address, erc20, amount,
    evm_nonce, gas_limit, max_fee, max_priority_fee, key_version, auth_nonce
  );
  const digest = evm_digest_bridge_deposit_start(
    kernel.self().bytes, evm_domain_salt, address, auth_nonce,
    erc20, amount, evm_nonce, gas_limit, max_fee, max_priority_fee, key_version, challenge
  );
  require_authorised_with_evm(pk, use_counter, sig, digest, address);
  vault.startDeposit(
    disclose(evm_nonce), disclose(gas_limit), disclose(max_fee), disclose(max_priority_fee),
    disclose(key_version), disclose(erc20), disclose(amount),
    // The pinned recipient. It is `kernel.self()` and nothing else, in every build of this
    // contract: the MPC derivation path — and therefore the Ethereum address the user
    // funded — is a function of it, so an account cannot sweep another account's deposit
    // address, and the minted coin cannot land anywhere but here.
    right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
  );
}

// Settle a deposit. Permissionless (see the banner): the vault's in-circuit attestation
// check is the only authority.
//
// `entry` is the account-encrypted description of the coin the vault is about to mint, in
// the same InboxEntry v1 container `deposit_shielded` takes. The client knows the coin
// before proving because it dry-runs this very call locally first and reads `minted.value`
// (question Q11 option A); the `mint_nonce` it passes is what makes the coin predictable.
// A wrong entry strands discovery, never funds — the coin is claimed either way, and the
// owner can recover it by rescanning and re-filing with `append_inbox_with_evm` (INV-4).
//
// The `none` branch is a deposit whose ERC20 `transfer` executed and returned FALSE: the
// vault closes the request without minting, because the value never left the depositor's
// own derived address. Nothing is claimed, nothing is appended, and `round` still advances
// so a client watching state sees the settle landed.
export circuit bridge_deposit_complete(
  request_id:  RequestId,
  // `event` is a reserved keyword in Compact 0.26, so the MPC's attestation travels under
  // its role name here; it is the vault's `respondBidirectionalEvent` argument unchanged.
  attestation: RespondBidirectionalEvent,
  output:      Bytes<1>,
  mint_nonce:  Bytes<32>,
  entry:       Bytes<192>,
): Maybe<ShieldedCoinInfo> {
  const minted = vault.completeDeposit(
    disclose(request_id), disclose(attestation), disclose(output), disclose(mint_nonce)
  );
  if (disclose(minted.is_some)) {
    // The claim that makes the callee's mint legal, in the same transaction (Gate 0 G1).
    receiveShielded(minted.value);
    do_append_inbox(entry);
    bump_round();
    return some<ShieldedCoinInfo>(minted.value);
  }
  bump_round();
  return none<ShieldedCoinInfo>();
}

// Start a withdrawal: hand `amount` of the vault colour back to the vault and have the MPC
// sign `transfer(dest, amount)` from the VAULT's own Ethereum account.
//
// One transaction, three contract calls, and value crossing the boundary in the direction
// Gate 0's G1b proved: this account's `sendShielded` creates a vault-addressed output, the
// vault claims that exact output with `receiveShielded` inside the same tree, and the vault
// then calls the singleton. The surrendered coin is not burned — it is claimed and left
// unspendable (question Q24), which is the same economics in the one shape a callee may use.
//
// The change coin follows the MIP-0012 surviving-coin rule. Its inbox entry is an ARGUMENT
// so that one transaction can create the change AND make it discoverable, but the entry is
// NOT part of the signed challenge — see `challenge_bridge_withdraw_start_with_evm` for the
// measurement behind that (question Q41). A caller that cannot predict the change coin
// passes 32 zero bytes' worth of nothing (any 192 bytes: a spend of the WHOLE coin never
// reaches the append at all) and re-files later with `append_inbox_with_evm`.
export circuit bridge_withdraw_start_with_evm(
  dest:             Bytes<20>,
  color:            Bytes<32>,
  amount:           Uint<128>,
  evm_nonce:        Uint<64>,
  gas_limit:        Uint<64>,
  max_fee:          Uint<128>,
  max_priority_fee: Uint<128>,
  key_version:      Uint<8>,
  erc20:            Bytes<20>,
  change_entry:     Bytes<192>,
  pk:               Secp256k1Point,
  use_counter:      Uint<64>,
  sig:              Secp256k1EcdsaSignature,
): Maybe<ShieldedCoinInfo> {
  // The witness runs BEFORE the challenge, so the coin it returns is pinned by the
  // signature (AUTH-10), exactly as in withdraw_shielded_with_evm.
  const coin = held_coin(color);
  const address = secp256k1EthereumAddress(pk);
  const challenge = challenge_bridge_withdraw_start_with_evm(
    kernel.self(), address, dest, color, amount,
    evm_nonce, gas_limit, max_fee, max_priority_fee, key_version, erc20,
    coin, auth_nonce
  );
  const digest = evm_digest_bridge_withdraw_start(
    kernel.self().bytes, evm_domain_salt, address, auth_nonce,
    dest, color, amount, evm_nonce, gas_limit, max_fee, max_priority_fee, key_version, challenge
  );
  require_authorised_with_evm(pk, use_counter, sig, digest, address);

  // Not do_withdraw_shielded_to_contract: the vault needs the SENT coin as a call argument
  // (it claims that exact description), and the chip returns it inside a tuple. The send is
  // otherwise identical, including the change rule.
  const result = sendShielded(
    disclose(coin),
    right<ZswapCoinPublicKey, ContractAddress>(vault_address),
    disclose(amount),
  );
  vault.startWithdraw(
    disclose(evm_nonce), disclose(gas_limit), disclose(max_fee), disclose(max_priority_fee),
    disclose(key_version), disclose(erc20), disclose(amount), disclose(dest),
    disclose(result.sent),
    // The refund recipient, pinned for the whole life of the request: a withdrawal whose
    // EVM leg fails can re-mint only into this account (spec FR-026, question Q21b).
    right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
  );
  if (disclose(result.change.is_some)) {
    do_append_inbox(change_entry);
    return some<ShieldedCoinInfo>(disclose(result.change.value));
  }
  return none<ShieldedCoinInfo>();
}

// Settle an EXECUTED withdrawal. Permissionless. Two branches, decided by the attested
// return value and never by the caller: on success the request simply closes (the ERC20 is
// already at `dest` on the EVM chain, and nothing comes back to Midnight); on a `transfer`
// that executed and returned FALSE the vault re-mints the surrendered amount to the pinned
// recipient — this account — which claims it here and files its inbox entry.
export circuit bridge_withdraw_complete(
  request_id:  RequestId,
  // `event` is a reserved keyword in Compact 0.26, so the MPC's attestation travels under
  // its role name here; it is the vault's `respondBidirectionalEvent` argument unchanged.
  attestation: RespondBidirectionalEvent,
  output:      Bytes<1>,
  mint_nonce:  Bytes<32>,
  entry:       Bytes<192>,
): Maybe<ShieldedCoinInfo> {
  const refunded = vault.completeWithdraw(
    disclose(request_id), disclose(attestation), disclose(output), disclose(mint_nonce)
  );
  if (disclose(refunded.is_some)) {
    receiveShielded(refunded.value);
    do_append_inbox(entry);
    bump_round();
    return some<ShieldedCoinInfo>(refunded.value);
  }
  bump_round();
  return none<ShieldedCoinInfo>();
}

// Settle a NEVER-EXECUTED withdrawal: the MPC signed, nobody broadcast (or the signed
// transaction became unusable), and the MPC attested the protocol's fixed 5-byte
// never-executed marker. The vault always re-mints in this branch, so unlike the two
// settles above this one carries no `Maybe` — a coin is always claimed.
//
// There is no account-side twin for the vault's `abandonDeposit`: a never-executed DEPOSIT
// surrendered no Midnight value, so closing it mints nothing and touches no account state.
// Anyone calls it on the vault directly.
export circuit bridge_withdraw_refund(
  request_id:  RequestId,
  // `event` is a reserved keyword in Compact 0.26, so the MPC's attestation travels under
  // its role name here; it is the vault's `respondBidirectionalEvent` argument unchanged.
  attestation: RespondBidirectionalEvent,
  output:      Bytes<5>,
  mint_nonce:  Bytes<32>,
  entry:       Bytes<192>,
): ShieldedCoinInfo {
  const refunded = vault.refundWithdraw(
    disclose(request_id), disclose(attestation), disclose(output), disclose(mint_nonce)
  );
  receiveShielded(refunded);
  do_append_inbox(entry);
  bump_round();
  return refunded;
}
